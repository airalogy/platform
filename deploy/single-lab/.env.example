# Generated and maintained by deploy/single-lab/scripts/generate-env.sh.
COMPOSE_PROJECT_NAME=airalogy-single-lab
PLATFORM_VERSION=0.1.0
AIRALOGY_DEPLOYMENT_ID=dep_00000000000000000000000000000000
GIT_TAG=
GIT_COMMIT=unknown
BUILD_TIME=
BUILD_DIRTY=true
AIRALOGY_RELEASE_MANIFEST_SHA256=
AIRALOGY_API_IMAGE=airalogy-platform-api:0.1.0
AIRALOGY_WEB_IMAGE=airalogy-platform-web:0.1.0
AIRALOGY_PROTOCOL_EXECUTOR_IMAGE=airalogy-platform-protocol-executor:0.1.0
AIRALOGY_POSTGRES_IMAGE=airalogy-platform-postgres:0.1.0
AIRALOGY_RELEASE_METADATA_REQUIRED=false
AIRALOGY_RELEASE_MANIFEST_FILE=./release-manifest.json
AIRALOGY_RELEASE_METADATA_FILE=./release-manifest.env
AIRALOGY_STATE_DIR=./state/dep_00000000000000000000000000000000
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2024-03-26T22-10-45Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2024-03-25T16-41-14Z
COMPONENT_BUILD_MEMORY_MB=3072
WEB_BUILD_MEMORY_MB=6144

# Use :80 for local HTTP. For automatic TLS, use a public DNS name and map
# host ports 80/443 below.
SITE_URL=http://localhost:8080
SITE_ADDRESS=:80
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=8443
TLS_EMAIL=admin@example.org

APP_ENV=production
DEPLOYMENT_MODE=single_lab
LAB_STRUCTURE_MODE=structured
API_ROOT_PATH=
SIGNUP_MODE=invite_only
DOCUMENTATION_PROFILE=customer_managed
DOCUMENTATION_URL=/docs/
# Set only for a vendor-managed deployment with a customer-facing support portal.
SUPPORT_URL=
SINGLE_LAB_UID=main
SINGLE_LAB_NAME=Airalogy Lab
SINGLE_LAB_DESCRIPTION=
SINGLE_LAB_DEFAULT_PROJECT_UID=lab_protocols
SINGLE_LAB_DEFAULT_PROJECT_NAME=Lab Protocols
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60

# Replace every placeholder with a generated secret before startup.
SECRET_KEY=replace-with-generated-secret
AES_KEY=replace-with-64-hex-characters
INNER_API_KEY=replace-with-generated-inner-key
INITIAL_ADMIN_TOKEN=replace-with-generated-setup-code

POSTGRES_USER=airalogy
POSTGRES_PASSWORD=replace-with-generated-database-password
POSTGRES_DB=airalogy

STORAGE_BACKEND=minio
MINIO_ROOT_USER=airalogy
MINIO_ROOT_PASSWORD=replace-with-generated-storage-password
MINIO_BUCKET=airalogy
MINIO_CONSOLE_PORT=9201
REDIS_MAXMEMORY=256mb

LOG_REQUEST_BODIES=false
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARNING
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
RECORD_DELETE_GRACE_DAYS=7
MAX_LABS_PER_USER=1

VITE_APP_TITLE=Airalogy Lab
VITE_APP_DESC=Private laboratory research workspace.
VITE_DOCS_URL=/docs/

APT_DEBIAN_MIRROR=http://deb.debian.org/debian
APT_DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
APT_POSTGRES_MIRROR=http://apt.postgresql.org/pub/repos/apt

# Optional AI providers.
# Leave blank to auto-detect from providers; set false to hide and reject all AI features.
AI_ENABLED=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Set true only after configuring OpenAI or an external Masterbrain endpoint.
ENABLE_GPT_MODEL=false
MASTERBRAIN_CALL_MODE=package
CHAT_API_ENDPOINT=
CHAT_MODEL_FAST=qwen3.5-flash
CHAT_MODEL_ACCURATE=qwen3.5-plus
CHAT_MODEL_DEEP=qwen-max

# SMS login is disabled by default so Single-Lab does not require an SMS provider.
SMS_LOGIN_ENABLED=false
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SMS_SIGN_NAME=
ALIBABA_CLOUD_SMS_VERIFY_CODE_TEMPLATE_CODE=
ALIBABA_CLOUD_SMS_SENDER_ID=
SMS_COUNTRY_CODE_ALLOWLIST=

# Official multi-architecture Engine image for linux/amd64 and linux/arm64.
AIRALOGY_ENGINE_IMAGE=ghcr.io/airalogy/airalogy-engine:0.16.0@sha256:5d26af0a28fc42f042cf079ac6e00b1a4435ff2d1fd02631c5d356bfdd0e08b7
AIRALOGY_ENGINE_DEBUG=false
AIRALOGY_ENGINE_BOXLITE_HOME=

BACKUP_DIR=./backups
