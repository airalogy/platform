#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
command_name="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

usage() {
  cat <<'EOF'
Usage: ./platformctl <command> [options]

Commands:
  install         Validate and start the complete Platform release
  upgrade         Back up, verify, and upgrade the complete release
  rollback        Restore the previous images and matching data backup
  status          Show service health and verified release identity
  support-bundle  Create a sanitized diagnostic bundle
  backup          Create a consistent database and object backup
  restore         Restore a matching backup
  preflight       Validate deployment configuration and release metadata
  logs            Follow API and Web logs
  stop            Stop services without deleting data
EOF
}

case "$command_name" in
  install) exec "$SCRIPT_DIR/scripts/start.sh" "$@" ;;
  upgrade) exec "$SCRIPT_DIR/scripts/upgrade.sh" "$@" ;;
  rollback) exec "$SCRIPT_DIR/scripts/rollback.sh" "$@" ;;
  status) exec "$SCRIPT_DIR/scripts/status.sh" "$@" ;;
  support-bundle) exec "$SCRIPT_DIR/scripts/support-bundle.sh" "$@" ;;
  backup) exec "$SCRIPT_DIR/scripts/backup.sh" "$@" ;;
  restore) exec "$SCRIPT_DIR/scripts/restore.sh" "$@" ;;
  preflight) exec "$SCRIPT_DIR/scripts/preflight.sh" "$@" ;;
  logs)
    source "$SCRIPT_DIR/scripts/lib.sh"
    require_env_file
    exec docker compose --project-directory "$DEPLOY_DIR" --env-file "$ENV_FILE" -f "$COMPOSE_FILE" logs --follow api-server web
    ;;
  stop) exec "$SCRIPT_DIR/scripts/stop.sh" "$@" ;;
  "") usage ;;
  *) usage >&2; exit 2 ;;
esac
