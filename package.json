{
  "name": "@airalogy/platform",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "description": "Airalogy Platform Community Edition monorepo",
  "scripts": {
    "api:dev": "uv --directory apps/api run fastapi dev app --host 0.0.0.0 --port 4000 --reload",
    "api:check": "uv --directory apps/api run --no-sync python -m py_compile app/main.py",
    "api:test": "uv --directory apps/api run --with pytest python -m pytest tests",
    "gateway:test": "PYTHONPATH=apps/instrument-gateway/src python3 -m unittest discover -s apps/instrument-gateway/tests",
    "dev:prepare": "pnpm --filter @airalogy/components prepare",
    "dev": "pnpm run docs:build:web && pnpm --filter @airalogy/web dev",
    "build:prepare": "pnpm --filter @airalogy/components build",
    "build": "pnpm run build:prepare && pnpm run docs:build:web && NODE_OPTIONS=--max-old-space-size=6144 pnpm --filter @airalogy/web build",
    "build:no-check": "pnpm run build:prepare && pnpm run docs:build:web && pnpm --filter @airalogy/web build:no-check",
    "preview": "pnpm --filter @airalogy/web preview",
    "lint": "pnpm --recursive --parallel lint",
    "lint:fix": "pnpm --recursive --parallel lint:fix",
    "format": "pnpm --recursive --parallel format",
    "type-check": "pnpm --recursive --parallel type-check",
    "test": "pnpm --recursive --parallel test",
    "e2e": "bash tests/e2e/scripts/run.sh",
    "e2e:test": "playwright test",
    "e2e:headed": "E2E_HEADED=1 bash tests/e2e/scripts/run.sh",
    "clean": "pnpm --recursive --parallel clean && rm -rf node_modules",
    "clean:dist": "pnpm --recursive --parallel clean:dist",
    "install:all": "pnpm install",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "prepush:check": "node scripts/pre-push.mjs",
    "prepush:full": "node scripts/pre-push.mjs --full",
    "prepush:test": "node --test scripts/pre-push.test.mjs",
    "i18n:generate": "node scripts/generate-i18n-types.mjs",
    "version:check": "node scripts/check-version.mjs",
    "build:info": "node scripts/write-build-info.mjs apps/api/app/build-info.json",
    "release:metadata:test": "node --test scripts/release-metadata.test.mjs",
    "deployment:identity:test": "bash scripts/deployment-identity.test.sh",
    "docs:dev": "DOCS_BASE=/docs/ vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:build:web": "DOCS_BASE=/docs/ DOCS_OUT_DIR=../apps/web/public/docs vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release:check": "pnpm version:check && node scripts/check-release.mjs"
  },
  "dependencies": {
    "lodash-es": "catalog:",
    "nanoid": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@playwright/test": "^1.62.0",
    "@unocss/core": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "@unocss/preset-icons": "catalog:",
    "@unocss/preset-uno": "catalog:",
    "@unocss/transformer-directives": "catalog:",
    "@unocss/transformer-variant-group": "catalog:",
    "@unocss/vite": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "catalog:"
  },
  "pnpm": {
    "patchedDependencies": {
      "prosemirror-tables@1.6.4": "patches/prosemirror-tables@1.6.4.patch",
      "naive-ui@2.41.0": "patches/naive-ui@2.41.0.patch",
      "smol-toml@1.3.4": "patches/smol-toml@1.3.4.patch"
    }
  },
  "lint-staged": {
    "*.{js,ts,vue,jsx,tsx}": [
      "eslint --fix --cache --quiet"
    ],
    "*.{scss,css,json,md}": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
