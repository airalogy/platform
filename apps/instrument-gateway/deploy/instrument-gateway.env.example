AIRALOGY_PLATFORM_URL=https://lab.example.edu/api
AIRALOGY_GATEWAY_TOKEN=replace-with-the-one-time-gateway-credential
AIRALOGY_GATEWAY_ADAPTER=replace-with-the-locally-installed-adapter-name
AIRALOGY_GATEWAY_ADAPTER_CONFIG=/etc/airalogy/instrument-adapter.json
AIRALOGY_GATEWAY_STATE_FILE=/var/lib/airalogy-instrument-gateway/state.json
AIRALOGY_GATEWAY_POLL_SECONDS=15
AIRALOGY_GATEWAY_HEARTBEAT_SECONDS=30
AIRALOGY_GATEWAY_REQUEST_TIMEOUT_SECONDS=10
AIRALOGY_GATEWAY_STOP_TIMEOUT_SECONDS=30
