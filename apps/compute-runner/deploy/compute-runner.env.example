AIRALOGY_PLATFORM_URL=https://lab.example.edu
AIRALOGY_COMPUTE_RUNNER_TOKEN=aicr_replace_with_one_time_credential
AIRALOGY_COMPUTE_BACKEND=podman
AIRALOGY_COMPUTE_HELPER_IMAGE=registry.example.edu/airalogy/compute-helper@sha256:replace_with_digest
AIRALOGY_COMPUTE_STATE_FILE=/var/lib/airalogy-compute-runner/state.json
AIRALOGY_COMPUTE_POLL_SECONDS=15
AIRALOGY_COMPUTE_HEARTBEAT_SECONDS=20
AIRALOGY_COMPUTE_REQUEST_TIMEOUT_SECONDS=15
AIRALOGY_COMPUTE_OUTPUT_UPLOAD_TIMEOUT_SECONDS=3600
AIRALOGY_COMPUTE_STOP_TIMEOUT_SECONDS=20
AIRALOGY_COMPUTE_MAX_WORKSPACE_BYTES=10737418240
AIRALOGY_COMPUTE_EGRESS_NETWORKS_JSON={}
