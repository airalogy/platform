[Unit]
Description=Airalogy governed Compute Runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=airalogy-compute
Group=airalogy-compute
WorkingDirectory=/opt/airalogy-compute-runner
EnvironmentFile=/etc/airalogy/compute-runner.env
ExecStart=/opt/airalogy-compute-runner/.venv/bin/airalogy-compute-runner
Restart=on-failure
RestartSec=5
UMask=0077

StateDirectory=airalogy-compute-runner
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/airalogy-compute-runner

[Install]
WantedBy=multi-user.target
