{
  "name": "@airalogy/instrument-interface",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Bounded browser and macOS interface observation with supervised synthetic browser replay",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/browser-session.mjs",
    "./contract": "./src/contract.mjs"
  },
  "bin": {
    "airalogy-instrument-interface": "./src/cli.mjs",
    "airalogy-interface-exploration": "./src/exploration-cli.mjs",
    "airalogy-interface-workflow": "./src/workflow-cli.mjs",
    "airalogy-interface-demonstration": "./src/demonstration-cli.mjs",
    "airalogy-interface-runtime": "./src/worker-runtime-cli.mjs",
    "airalogy-interface-survey": "./src/survey-cli.mjs",
    "airalogy-interface-native": "./src/native-cli.mjs"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint src tests --quiet",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "RUN_INTERFACE_BROWSER_TESTS=1 node --test tests/*.test.mjs",
    "test:native": "RUN_INTERFACE_NATIVE_TESTS=1 node --test tests/native.test.mjs"
  },
  "dependencies": {
    "ajv": "catalog:",
    "playwright": "catalog:"
  }
}
